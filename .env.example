# MongoDB connection string used by the /api/travel-packages route handler.
# Local:  mongodb://127.0.0.1:27017/wanderlust
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/wanderlust
MONGODB_URI=mongodb://127.0.0.1:27017/wanderlust

# Optional database name override (defaults to the one in the connection string).
MONGODB_DB=wanderlust

# Base URL of the external Express API (server-side fetch of /destinations).
DESTINATIONS_API_URL=http://localhost:8000

# Same URL, needed by client components (the add form posts from the browser).
NEXT_PUBLIC_DESTINATIONS_API_URL=http://localhost:8000
